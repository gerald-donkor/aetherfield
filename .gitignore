# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the canonical variable list, which AGENTS.md 8.4 requires to be
# committed. Without this negation `.env*` swallows it, `git add` skips it
# silently, and the list never lands in the repository. Names only, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills
# The Drizzle docs snapshot is ~4 MB across 240 pages and is regenerable by
# .agents/skills/drizzle-docs/scripts/sync_drizzle_docs.py, so it is not
# tracked — the script and the source stanza next to it are. The Zod snapshot
# is 13 pages / ~288 KB and IS committed, deliberately, so that skill needs no
# setup on a fresh clone.
/.agents/skills/drizzle-docs/references/docs/
/.agents/skills/drizzle-docs/references/docs-index.md
